#!/bin/bash
# AetherNX command-line tool. Run ./aethernx help for the commands.
# Uses $AETHERNX_PYTHON, else the project's .venv (made by ./aethernx setup), else python3 on PATH.
set -eu

self="$0"
while [ -L "$self" ]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *) self="$(dirname "$self")/$link" ;;
  esac
done
root="$(cd "$(dirname "$self")" && pwd -P)"

if [ -n "${AETHERNX_PYTHON:-}" ]; then
  python="$AETHERNX_PYTHON"
elif [ -x "$root/.venv/bin/python3" ]; then
  python="$root/.venv/bin/python3"
else
  python="$(command -v python3 || true)"
fi

if [ -z "$python" ]; then
  echo "aethernx: Python 3 was not found. Install it (brew install python), then run ./aethernx setup" >&2
  exit 1
fi

exec "$python" "$root/scripts/aethernx_cli.py" "$@"
