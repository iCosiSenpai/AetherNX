# Build outputs (Xcode derived data, produced by the scripts under dm/ios)
.iosdd/
.iosdd_mac/
.iosdd_*/
.DS_Store
__pycache__/
# Made from each shader build's Mac outputs (c1_guard.py, cb_extent.py; the NSP script makes them), not committed
dm/games/*/c1_full.tsv
dm/games/*/cb_extent.tsv
# coverage.py data and its JSON report (pyproject.toml, [tool.coverage.run])
.coverage
.coverage.*
/coverage.json

# Never track game dumps, keys, firmware, or per-title build workspaces
*.nsp
*.xci
*.nsz
*.xcz
*.keys
*.ipa
*_build/
dm/build/


# The Python environment ./aethernx setup makes
/.venv/
# Studio app build output (released as a signed download, never committed)
/build/
/AetherNX.app/
# Local design-tool state
/.impeccable/

# Local plan and context notes for agents (requests, status, decisions); never committed
/plan-context/

# The website, built by site/tools/build.py (.github/workflows/pages.yml)
/_site/
site/tools/__pycache__/
